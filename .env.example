# Environment variables for Chest X-Ray Classification Project
# Copy this file to .env and modify as needed

# User/Group IDs for Docker (match your host user for file permissions)
UID=1000
GID=1000

# Jupyter Lab token (optional, leave empty for no token)
JUPYTER_TOKEN=

# Weights & Biases (optional - only if you want cloud tracking)
# WANDB_API_KEY=your_api_key_here
# WANDB_ENTITY=your_entity
# WANDB_PROJECT=chestxray-classification

# Hugging Face (optional - only if you need private models)
# HF_TOKEN=your_hf_token_here

# Dataset path (if different from default ./dataset)
# DATASET_PATH=/path/to/your/dataset

# Training device (cpu, cuda, mps)
# DEVICE=cuda

# PyTorch settings
PYTHONUNBUFFERED=1